{
  "mcpServers": {
    "dart": {
      "command": "dart",
      "args": [
        "mcp-server"
      ]
    },
    "firebase": {
      "command": "npx",
      "args": [
        "-y",
        "firebase-tools@latest",
        "experimental:mcp"
      ]
    },
    "stitch": {
      "command": "npx",
      "args": [
        "-y",
        "@_davideast/stitch-mcp"
      ]
    },
    "vercel": {
      "command": "npx",
      "args": [
        "-y",
        "@mistertk/vercel-mcp"
      ]
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase"
      ],
      "env": {
        "SUPABASE_PERSONAL_ACCESS_TOKEN": "sbp_33182b7e6247c2ed6d2b5650b6e4d6549a50cd0"
      }
    }
  }
}
